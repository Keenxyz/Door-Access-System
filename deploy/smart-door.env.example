# Use a stable /dev/v4l/by-id/...-video-index0 path when available.
SMART_DOOR_CAMERA=/dev/video0

# Use "aplay -L" to find a device, for example plughw:CARD=Device,DEV=0.
SMART_DOOR_ALSA_DEVICE=default

# Leave empty for recognition, LEDs and speech with GPIO 23 disabled.
SMART_DOOR_ARGS=
# Optional flags after checking the wiring: --doorbell --oled-ssd1306 128x64 --oled-address 0x3c

# Uncomment and fill these to send events through a paired writer account.
# Put the password in /etc/smart-door/writer-password using the deployment guide.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# SUPABASE_DEVICE_EMAIL=writer@example.com
